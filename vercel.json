{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/blog/kibris-escort-kimlik-istiyor-mu", "destination": "/blog/escort-kimlik-ister-mi-kktc-yasal", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/blog/:slug", "destination": "/api/post?slug=:slug" },

    { "source": "/girne-escort", "destination": "/api/region?slug=girne-escort" },
    { "source": "/lefkosa-escort", "destination": "/api/region?slug=lefkosa-escort" },
    { "source": "/magusa-escort", "destination": "/api/region?slug=magusa-escort" },
    { "source": "/iskele-escort", "destination": "/api/region?slug=iskele-escort" },
    { "source": "/guzelyurt-escort", "destination": "/api/region?slug=guzelyurt-escort" },
    { "source": "/karaoglanoglu-escort", "destination": "/api/region?slug=karaoglanoglu-escort" },
    { "source": "/alsancak-escort", "destination": "/api/region?slug=alsancak-escort" },
    { "source": "/lapta-escort", "destination": "/api/region?slug=lapta-escort" },
    { "source": "/catalkoy-escort", "destination": "/api/region?slug=catalkoy-escort" },
    { "source": "/bellapais-escort", "destination": "/api/region?slug=bellapais-escort" },
    { "source": "/esentepe-escort", "destination": "/api/region?slug=esentepe-escort" },
    { "source": "/long-beach-escort", "destination": "/api/region?slug=long-beach-escort" },
    { "source": "/bafra-escort", "destination": "/api/region?slug=bafra-escort" },
    { "source": "/gonyeli-escort", "destination": "/api/region?slug=gonyeli-escort" },
    { "source": "/otele-escort", "destination": "/api/region?slug=otele-escort" },
    { "source": "/eve-gelen-escort", "destination": "/api/region?slug=eve-gelen-escort" },
    { "source": "/gecelik-escort", "destination": "/api/region?slug=gecelik-escort" },
    { "source": "/vip-escort", "destination": "/api/region?slug=vip-escort" },
    { "source": "/ogrenci-escort", "destination": "/api/region?slug=ogrenci-escort" },
    { "source": "/turk-escort", "destination": "/api/region?slug=turk-escort" },
    { "source": "/rus-escort", "destination": "/api/region?slug=rus-escort" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=600" }
      ]
    },
    {
      "source": "/api/sitemap",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=600" }
      ]
    }
  ]
}
